# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI — server side only, never expose with NEXT_PUBLIC_
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-luna

# Resource discovery registry
# local-demo = reliable synthetic catalog (default)
# bazaar     = x402 Bazaar HTTP GET resources only
# hybrid     = local demo catalog + Bazaar, with local fallback if Bazaar is unavailable
POLICYRAIL_RESOURCE_REGISTRY_MODE=local-demo
# Optional override. By default PolicyRail tries the public CDP x402 Bazaar first,
# then falls back to the x402.org test Bazaar.
POLICYRAIL_BAZAAR_URL=

# x402 / Solana Devnet — server side only
POLICYRAIL_X402_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
X402_FACILITATOR_URL=https://x402.org/facilitator
POLICYRAIL_AGENT_ADDRESS=
POLICYRAIL_AGENT_PRIVATE_KEY=
POLICYRAIL_MERCHANT_ADDRESS=
POLICYRAIL_MERCHANT_PRIVATE_KEY=
